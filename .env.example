APP_NAME=Arc
APP_URL="127.0.0.1"
APP_PORT=8080

# Storage backend behind the EventStore/ReadModelStore traits.
#   sqlite   (default) — local file at DATABASE_URL.
#   postgres            — connection string at DATABASE_URL; requires building
#                         the app with the `postgres` cargo feature.
DATABASE_DRIVER=sqlite

# Environment: development, production
# In development, cookies work without HTTPS and across network IPs
# In production, cookies require HTTPS and strict security
APP_ENV=development

# The URL to the database.
# SQLite (default driver): path to the database file.
DATABASE_URL=database/database.sqlite
# Postgres driver example (set DATABASE_DRIVER=postgres and uncomment):
# DATABASE_URL=postgres://arc:password@127.0.0.1:5432/arc_dev

# HIPAA-5 event integrity. Set to a secret 32+ byte value to sign new SQLite
# events and verify signatures on load/stream. Existing unsigned rows must be
# backfilled before enabling this on an old database.
# EVENT_INTEGRITY_KEY=change-me-to-at-least-32-bytes-long
# EVENT_INTEGRITY_KEY_ID=default

# User aggregate snapshots are a best-effort rehydrate cache; events remain
# source of truth. Default is 50. Set <= 0 to disable user snapshots.
# USER_SNAPSHOT_INTERVAL_EVENTS=50

# Shared bearer token for Benthos -> Arc internal projection endpoints.
# Required when distributed projection handlers are enabled.
# INTERNAL_PROJECTION_TOKEN=change-me-32-bytes-or-more

# The JWT session-revocation registry is SQLite-only today. Under
# DATABASE_DRIVER=postgres it keeps its own local SQLite file (default below).
# SESSION_DATABASE_URL=database/sessions.sqlite

# Session Configuration
# This is a secret key that is used to sign the session cookie.
SECRET_KEY=your-super-secret-session-key-change-this-in-production-at-least-32-chars

# Session cookie domain (optional)
# Leave empty for development to allow network access via IP
# Set to your domain in production (e.g., ".example.com")
# SESSION_DOMAIN=

# Session cookie same-site policy: Lax, Strict, None
# Lax = Good balance (recommended)
# Strict = Maximum security but may break some flows
# None = Least secure, requires HTTPS
SESSION_SAME_SITE=Lax

# JWT Configuration
ENABLE_JWT_AUTH=false
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-at-least-32-chars
JWT_EXPIRY_HOURS=24

# Rate Limiting Configuration (Login endpoints)
# Maximum number of login attempts per time period
RATE_LIMIT_MAX_REQUESTS=5
# Time period in seconds for login rate limiting
RATE_LIMIT_PERIOD_SECS=60

# Global Rate Limiting Configuration (All endpoints)
# Maximum number of requests per IP per time period
GLOBAL_RATE_LIMIT_MAX_REQUESTS=100
# Time period in seconds for global rate limiting
GLOBAL_RATE_LIMIT_PERIOD_SECS=60

# Opt-in read audit: use a dedicated persistent path; no implicit retention policy.
ACCESS_LOG_DRIVER=noop
ACCESS_LOG_REQUIRED=false
# ACCESS_LOG_SQLITE_PATH=/var/lib/arc-audit/access.db
ACCESS_LOG_BUSY_TIMEOUT_MS=1000
ACCESS_LOG_INCLUDE_SOURCE_IP=false
ACCESS_LOG_INCLUDE_USER_AGENT=false
