{% extends "layouts/admin.html" %}{% import "components/ui.html" as ui %}{% block content %}<header class="page-head"><div><p class="eyebrow">Resource / collection</p><h1>{{Type}} records</h1></div><a class="button button--primary" href="/admin/{{view}}/new">New {{Type}}</a></header><form class="filter-bar" method="get"><label for="filter" class="mono">Filter</label><input id="filter" name="filter" value="{{ filter | default(value="") }}"><input type="hidden" name="sort" value="{{ sort }}"><button class="button">Apply</button>{% if filter %}<a href="/admin/{{view}}">Clear</a>{% endif %}</form><section class="panel">{% if rows %}<div class="data-wrap"><table class="data-table"><thead><tr><th>ID</th><th>Name</th><th>Version</th><th></th></tr></thead><tbody>{% for row in rows %}<tr><td class="mono">{{ row.id }}</td><td>{{ row.name }}</td><td class="mono">{{ row.version }}</td><td><a href="/admin/{{view}}/{{ row.id }}">Inspect</a></td></tr>{% endfor %}</tbody></table></div>{% else %}{{ ui::empty(title="No {{view}} found", detail="Create the first record or adjust the active filter.") }}{% endif %}<nav class="panel__head" aria-label="Pagination">{% if page > 1 %}<a href="?filter={{ filter | default(value="") | urlencode }}&sort={{ sort | urlencode }}&page={{ page - 1 }}">Previous</a>{% endif %}<span class="mono">PAGE {{ page }}</span>{% if has_next %}<a href="?filter={{ filter | default(value="") | urlencode }}&sort={{ sort | urlencode }}&page={{ page + 1 }}">Next</a>{% endif %}</nav></section>{% endblock content %}
